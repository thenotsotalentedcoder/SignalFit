# Required server-only PostgreSQL connection string
DATABASE_URL=
# Required server-only secret, at least 32 random characters
SESSION_SECRET=
# Optional server-only Gemini API key
GEMINI_API_KEY=
# Optional Gemini model name (defaults to gemini-3.5-flash)
GEMINI_MODEL=
# Optional comma-separated models tried when the primary returns provider errors
GEMINI_FALLBACK_MODELS=
